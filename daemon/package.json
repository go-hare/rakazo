{
  "name": "@rakazo/daemon",
  "version": "0.0.1",
  "private": true,
  "description": "本机 daemon：连上云端，在这台电脑上拉起已经登录的 agent，上下文留在本机。",
  "type": "module",
  "bin": {
    "rakazo-daemon": "src/main.ts"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "check": "bunx tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/main.ts --compile --outfile dist/rakazo-daemon"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
